#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${WR_IMAGE:-writing-robot:dev}"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

image_exists() {
    docker image inspect "$IMAGE" >/dev/null 2>&1
}

build_image() {
    echo "==> Building $IMAGE"
    docker build -t "$IMAGE" "$ROOT"
}

ensure_image() {
    if ! image_exists; then
        echo "==> Docker image '$IMAGE' not found."
        build_image
    fi
}

docker_run() {
    ensure_image

    docker run --rm -i \
        -u "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -v "$ROOT":/workspace \
        -w /workspace \
        "$IMAGE" \
        "$@"
}

docker_run_tty() {
    ensure_image

    docker run --rm -it \
        -u "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -v "$ROOT":/workspace \
        -w /workspace \
        "$IMAGE" \
        "$@"
}

run_phase4() {
    echo "==> Exporting Pinocchio verification data"
    docker_run python3 -m verification.export_matlab_reference

    command -v wslpath >/dev/null 2>&1 \
        || die "Phase 4 MATLAB launcher currently expects WSL."

    MATLAB_EXE="/mnt/c/Program Files/MATLAB/R2024a/bin/matlab.exe"

    [[ -x "$MATLAB_EXE" ]] \
        || die "MATLAB executable not found at: $MATLAB_EXE"

    WIN_REPO="$(wslpath -w "$ROOT")"

    echo "==> Running independent MATLAB verification"
    "$MATLAB_EXE" \
        -batch "cd('$WIN_REPO'); run('verification/verify_with_matlab.m')"
}

run_phase5() {
    echo "==> Running randomized controlled model mismatch"
    docker_run python3 -m verification.model_mismatch_experiment

    echo
    echo "==> Running mismatch on validated writing trajectory"
    docker_run python3 -m verification.writing_model_mismatch
}

run_phase6() {
    echo "==> Training and evaluating residual dynamics model"
    docker_run python3 -m learning.residual_ridge
}

run_gui() {
    ensure_image

    docker run --rm -it \
        -u "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -e DISPLAY="${DISPLAY:-}" \
        -e QT_QPA_PLATFORM=xcb \
        -v "$ROOT":/workspace \
        -v /tmp/.X11-unix:/tmp/.X11-unix \
        -w /workspace \
        "$IMAGE" \
        python3 -m ui.live_command_center
}

run_doctor() {
    echo "========================================"
    echo " Franka Writing Studio — Doctor"
    echo "========================================"
    echo

    failures=0

    ok()   { printf "  [OK]   %s\n" "$1"; }
    warn() { printf "  [WARN] %s\n" "$1"; }
    fail() {
        printf "  [FAIL] %s\n" "$1"
        failures=$((failures + 1))
    }

    echo "==> Environment"

    command -v git >/dev/null 2>&1 \
        && ok "$(git --version)" \
        || fail "Git not found"

    command -v docker >/dev/null 2>&1 \
        && ok "Docker CLI available" \
        || fail "Docker CLI not found"

    docker info >/dev/null 2>&1 \
        && ok "Docker engine reachable" \
        || fail "Docker engine unavailable"

    echo
    echo "==> Required project files"

    required=(
        "Dockerfile"
        "requirements.lock"
        "franka_mechanics.py"
        "experiments/writing_experiment.py"
        "simulation/pybullet_adapter.py"
        "tasks/writing_studio.py"
        "workcells/writing_studio.py"
        "urdfs/official_franka/fer.urdf"
        "urdfs/official_franka/fer_franka_hand_pybullet.urdf"
        "urdfs/pen_tool_pybullet.urdf"
    )

    for file in "${required[@]}"; do
        [[ -e "$ROOT/$file" ]] \
            && ok "$file" \
            || fail "Missing: $file"
    done

    echo
    echo "==> Franka submodule"

    submodule="$(
        git -C "$ROOT" submodule status --recursive 2>/dev/null || true
    )"

    if [[ -z "$submodule" ]]; then
        fail "Franka description submodule unavailable"
    elif [[ "$submodule" == -* ]]; then
        fail "Submodule not initialized"
    elif [[ "$submodule" == +* ]]; then
        warn "Submodule differs from pinned commit"
        echo "         $submodule"
    else
        ok "Pinned Franka description present"
        echo "         $submodule"
    fi

    echo
    echo "==> Docker image"

    if image_exists; then
        ok "$IMAGE available"
    else
        warn "$IMAGE not built — run ./wr build"
    fi

    echo
    echo "==> Repository integrity"

    if git -C "$ROOT" diff --check >/dev/null 2>&1 \
        && git -C "$ROOT" diff --cached --check >/dev/null 2>&1; then
        ok "No Git whitespace errors"
    else
        fail "Git whitespace errors detected"
    fi

    echo
    echo "==> GUI"

    if [[ -n "${DISPLAY:-}" ]]; then
        ok "DISPLAY=${DISPLAY}"
    else
        warn "DISPLAY unset — GUI may not launch"
    fi

    echo
    if (( failures == 0 )); then
        echo "DOCTOR: PASS"
        return 0
    fi

    echo "DOCTOR: FAIL ($failures issue(s))"
    return 1
}


run_audit() {
    echo "========================================"
    echo " Franka Writing Studio — Repository Audit"
    echo "========================================"

    echo
    echo "==> Git"
    git -C "$ROOT" status --short --branch

    echo
    echo "==> Top-level structure"
    find "$ROOT" \
        -maxdepth 1 \
        -mindepth 1 \
        ! -name '.git' \
        -printf '%y  %f\n' \
        | sort

    echo
    echo "==> Generated / temporary files"
    find "$ROOT" \
        \( \
            -type d -name '__pycache__' \
            -o -type d -name '.pytest_cache' \
            -o -type f -name '*.pyc' \
            -o -type f -name '*.pyo' \
            -o -type f -name '*.tmp' \
            -o -type f -name '*.temp' \
        \) \
        ! -path "$ROOT/.git/*" \
        -print 2>/dev/null \
        | sort

    echo
    echo "==> Root-owned generated files"
    find "$ROOT" \
        \( \
            -type d -name '__pycache__' \
            -o -type d -name '.pytest_cache' \
            -o -type f -name '*.pyc' \
            -o -type f -name '*.tmp' \
        \) \
        -user root \
        -print 2>/dev/null \
        | sort

    echo
    echo "==> SVG inputs"
    find "$ROOT/svg" \
        -maxdepth 1 \
        -type f \
        -name '*.svg' \
        -printf '%f\n' 2>/dev/null \
        | sort

    echo
    echo "==> Tracked file count"
    git -C "$ROOT" ls-files | wc -l

    echo
    echo "AUDIT: COMPLETE"
}


run_clean() {
    echo "==> Cleaning generated project files"

    find "$ROOT" \
        -type d \
        \( -name '__pycache__' -o -name '.pytest_cache' \) \
        -prune \
        -exec rm -rf {} + 2>/dev/null || true

    find "$ROOT" \
        -type f \
        \( \
            -name '*.pyc' \
            -o -name '*.pyo' \
            -o -name '*.tmp' \
            -o -name '*.temp' \
        \) \
        ! -path "$ROOT/.git/*" \
        -delete 2>/dev/null || true

    leftovers="$(
        find "$ROOT" \
            \( \
                -type d -name '__pycache__' \
                -o -type d -name '.pytest_cache' \
                -o -type f -name '*.pyc' \
                -o -type f -name '*.tmp' \
            \) \
            ! -path "$ROOT/.git/*" \
            -print 2>/dev/null || true
    )"

    if [[ -n "$leftovers" ]]; then
        echo "CLEAN: WARNING"
        echo "$leftovers"
        echo "Some files may be owned by root."
        return 1
    fi

    echo "CLEAN: PASS"
}


show_help() {
    cat <<EOF
Franka Workcell Launcher

Usage:
  ./wr <command>

Commands:
  build       Build/update Docker development image
  rebuild     Force clean Docker rebuild
  test        Run pytest suite
  shell       Open interactive development shell
  ui          Launch interactive command center
  phase4      Run Python -> MATLAB independent verification
  phase5      Generate controlled model-mismatch datasets
  phase6      Train/evaluate learned residual dynamics model
  doctor      Check environment and repository readiness
  audit       Inspect repository hygiene and generated files
  clean       Remove safe cache and temporary files
  status      Show Docker image and Git status
  help        Show this help

Environment:
  WR_IMAGE    Override Docker image name
              default: writing-robot:dev

Examples:
  ./wr build
  ./wr test
  ./wr ui
  ./wr phase6
EOF
}

COMMAND="${1:-help}"

case "$COMMAND" in
    build)
        build_image
        ;;

    rebuild)
        echo "==> Rebuilding $IMAGE without cache"
        docker build --no-cache -t "$IMAGE" "$ROOT"
        ;;

    test)
        docker_run python3 -m pytest -q
        ;;

    shell)
        docker_run_tty bash
        ;;

    ui)
        run_gui
        ;;

    phase4)
        run_phase4
        ;;

    phase5)
        run_phase5
        ;;

    phase6)
        run_phase6
        ;;

    doctor)
        run_doctor
        ;;

    audit)
        run_audit
        ;;

    clean)
        run_clean
        ;;

    status)
        echo "Repository: $ROOT"
        echo "Image:      $IMAGE"

        if image_exists; then
            echo "Docker:     READY"
        else
            echo "Docker:     NOT BUILT"
        fi

        echo
        git -C "$ROOT" status --short --branch
        ;;

    help|-h|--help)
        show_help
        ;;

    *)
        die "Unknown command '$COMMAND'. Run ./wr help."
        ;;
esac
